						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{adminToken}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"Test Station\",\n    \"address\": \"Test Address\",\n    \"latitude\": 33.5731,\n    \"longitude\": -7.5898,\n    \"connector_type\": \"Type 2\",\n    \"power_kw\": 22.0\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/admin/charging-stations",
							"host": ["{{baseUrl}}"],
							"path": ["api", "admin", "charging-stations"]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    const response = pm.response.json();",
									"    pm.environment.set(\"stationId\", response.id);",
									"}"
								]
							}
						}
					],
					"response": []
				},
				{
					"name": "Admin: Update Station",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{adminToken}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"Updated Station Name\",\n    \"power_kw\": 25.0\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/admin/charging-stations/{{stationId}}",
							"host": ["{{baseUrl}}"],
							"path": ["api", "admin", "charging-stations", "{{stationId}}"]
