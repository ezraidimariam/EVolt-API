							"path": ["api", "charging-stations", "search"],
							"query": [
								{
									"key": "latitude",
									"value": "33.5731"
								},
								{
									"key": "longitude",
									"value": "-7.5898"
								},
								{
									"key": "connector_type",
									"value": "Type 2"
